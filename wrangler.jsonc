{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabletop-whisperer",
  "main": "src/cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  // Files in public/ are served for free without running the Worker; /api/* has no file, so it reaches the Worker.
  "assets": { "directory": "public", "html_handling": "auto-trailing-slash" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }, { "name": "ADMIN", "class_name": "AdminDO" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["AdminDO"] }
  ],
  // ADMIN_TOKEN is a secret, not a var: `pnpm wrangler secret put ADMIN_TOKEN` (and --env staging). Locally: .dev.vars.
  // Keep room data in the EU. Changing this later strands existing rooms (their ids depend on it).
  // Local workerd does not implement jurisdictions, so `pnpm dev:cf` clears it.
  // Rooms unused this many days delete themselves (an alarm in each room's Durable Object).
  "vars": { "DO_JURISDICTION": "eu", "ROOM_EXPIRY_DAYS": "60" },
  "ratelimits": [
    { "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "CREATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
    { "name": "REPORT_LIMIT", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } }
  ],
  // Logs never include tokens: keys travel in URL fragments, JSON bodies and WebSocket messages only.
  "observability": { "enabled": true },
  "env": {
    // Bindings aren't inherited by environments, so they're repeated here.
    "staging": {
      "name": "tabletop-whisperer-staging",
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }, { "name": "ADMIN", "class_name": "AdminDO" }] },
      "vars": { "DO_JURISDICTION": "eu", "ROOM_EXPIRY_DAYS": "60" },
      "ratelimits": [
        { "name": "JOIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
        { "name": "CREATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } },
        { "name": "REPORT_LIMIT", "namespace_id": "1006", "simple": { "limit": 5, "period": 60 } }
      ]
    }
  }
}
